<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RemoControlMobile.AplicacionesPage"
    BackgroundColor="#161C25"
    Title="Aplicaciones">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- CABECERA -->
        <Grid
            Grid.Row="0"
            Padding="20"
            ColumnDefinitions="Auto,*">

            <Button
                Text="←"
                WidthRequest="50"
                HeightRequest="45"
                BackgroundColor="#1E2631"
                TextColor="White"
                CornerRadius="12"
                Clicked="BtnVolver_Clicked" />

            <VerticalStackLayout
                Grid.Column="1"
                Margin="15,0">

                <Label
                    Text="Aplicaciones"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="White" />

                <Label
                    Text="Aplicaciones autorizadas de esta PC"
                    FontSize="12"
                    TextColor="#8794A5" />

            </VerticalStackLayout>

        </Grid>


        <!-- BUSCADOR + AGREGAR -->
        <Grid
            Grid.Row="1"
            Padding="20,0,20,12"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Border
                Grid.Column="0"
                Padding="6"
                BackgroundColor="#151B23"
                Stroke="#293545">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>

                <Entry
                    x:Name="txtBuscar"
                    Placeholder="Buscar aplicación..."
                    PlaceholderColor="#657181"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    TextChanged="TxtBuscar_TextChanged" />

            </Border>

            <Button
                Grid.Column="1"
                Text="+ Agregar"
                BackgroundColor="#087BDB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                Padding="16,0"
                Clicked="BtnAgregar_Clicked" />

        </Grid>


        <!-- LISTA -->
        <RefreshView
            x:Name="refreshApps"
            Grid.Row="2"
            Refreshing="RefreshApps_Refreshing">

            <CollectionView
                x:Name="listaApps"
                Margin="15"
                SelectionMode="Single"
                SelectionChanged="ListaApps_SelectionChanged">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Padding="20"
                        Spacing="10">

                        <Label
                            Text="📱"
                            FontSize="50"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="No tienes aplicaciones agregadas"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Pulsa + Agregar para seleccionar aplicaciones de la PC."
                            FontSize="12"
                            TextColor="#8794A5"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>


                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="4"
                            Padding="14"
                            BackgroundColor="#1E2631"
                            Stroke="#293545">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>

                            <Grid
                                ColumnDefinitions="58,*,Auto"
                                ColumnSpacing="12">

                                <!-- ICONO REAL -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#151B23"
                                    StrokeThickness="0">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding IconImage}"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Aspect="AspectFit"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />

                                </Border>


                                <!-- NOMBRE -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="2">

                                    <Label
                                        Text="{Binding name}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="White"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="Toca para abrir u opciones"
                                        FontSize="11"
                                        TextColor="#8794A5" />

                                </VerticalStackLayout>


                                <!-- FAVORITO -->
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding FavoriteIcon}"
                                    FontSize="20"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>


        <!-- ESTADO -->
        <Grid
            Grid.Row="3"
            Padding="20,8,20,18"
            ColumnDefinitions="*,Auto">

            <Label
                x:Name="lblEstado"
                Text="● Listo"
                TextColor="#8794A5"
                FontSize="12"
                VerticalTextAlignment="Center" />

            <Button
                Grid.Column="1"
                Text="↻"
                WidthRequest="48"
                HeightRequest="42"
                BackgroundColor="#1E2631"
                TextColor="White"
                CornerRadius="10"
                Clicked="BtnActualizar_Clicked" />

        </Grid>

    </Grid>

</ContentPage>