<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RemoControlMobile.MainPage"
    x:Name="paginaPrincipal"
    BackgroundColor="#050B12"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Padding="18,16,18,12" ColumnDefinitions="Auto,*,Auto" BackgroundColor="#07101A">
            <HorizontalStackLayout Grid.Column="1" Margin="0" VerticalOptions="Center" Spacing="0">
                <Label x:Name="lblBrandName" Text="RemoControl" IsVisible="False" />
                <Label Text="Remo" TextColor="White" FontSize="22" FontAttributes="Bold, Italic" />
                <Label Text="Control" TextColor="#1687FF" FontSize="22" FontAttributes="Bold, Italic" />
            </HorizontalStackLayout>

            <Button Grid.Column="2" Text="⋮" FontSize="25" WidthRequest="44" HeightRequest="44"
                    BackgroundColor="Transparent" TextColor="White" Clicked="BtnConfiguracion_Clicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,8,18,24" Spacing="20">

                <!-- ESTADO -->
                <Border BackgroundColor="#0D1722" Stroke="#162536" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                        <HorizontalStackLayout Spacing="7">
                            <Label Text="●" TextColor="#25E36A" FontSize="15" VerticalTextAlignment="Center" />
                            <Label x:Name="lblEstado" Text="CONECTANDO..." TextColor="#25E36A" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" />
                        </HorizontalStackLayout>

                        <Border Grid.Column="1" Grid.RowSpan="3" WidthRequest="58" HeightRequest="58" BackgroundColor="#0A1C30" Stroke="#116ED0" Padding="12" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Image Source="ic_monitor.svg" />
                        </Border>

                        <Label Grid.Row="1" x:Name="lblPc" Text="Buscando tu PC..." TextColor="White" FontSize="21" FontAttributes="Bold" />
                        <Label Grid.Row="2" x:Name="lblUsuario" TextColor="#AAB8C8" FontSize="12" />
                        <Label Grid.Row="3" x:Name="lblWindows" TextColor="#6E7E91" FontSize="11" />
                        <Label Grid.Row="4" x:Name="lblServidor" Text="Servidor: no configurado" IsVisible="False" />
                    </Grid>
                </Border>

                <!-- ACCIONES RÁPIDAS -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Acciones rápidas" TextColor="White" FontSize="19" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Actualizar" FontSize="11" Padding="12,5" HeightRequest="34"
                                BackgroundColor="#0D1B29" TextColor="#7CBFFF" CornerRadius="10" Clicked="BtnActualizar_Clicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="125,125" ColumnSpacing="12" RowSpacing="12">
                        <Border BackgroundColor="#0D1722" Stroke="#182838" Padding="14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnBloquearRapido_Clicked" /></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                                <Label Text="▣" TextColor="#1687FF" FontSize="38" HorizontalTextAlignment="Center" />
                                <Label Text="Bloquear" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
                                
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#0D1722" Stroke="#182838" Padding="14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnSuspenderRapido_Clicked" /></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                                <Label Text="◐" TextColor="#1687FF" FontSize="42" HorizontalTextAlignment="Center" />
                                <Label Text="Suspender" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
                                
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" BackgroundColor="#0D1722" Stroke="#182838" Padding="14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnReiniciarRapido_Clicked" /></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                                <Label Text="↻" TextColor="#1687FF" FontSize="45" HorizontalTextAlignment="Center" />
                                <Label Text="Reiniciar" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
                                
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#0D1722" Stroke="#3C2022" Padding="14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="BtnApagarRapido_Clicked" /></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                                <Label Text="⏻" TextColor="#FF4949" FontSize="43" HorizontalTextAlignment="Center" />
                                <Label Text="Apagar" TextColor="White" FontSize="15" HorizontalTextAlignment="Center" />
                                
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- HERRAMIENTAS -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Herramientas" TextColor="White" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border BackgroundColor="#0D1722" Stroke="#182838" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="ic_monitor.svg" WidthRequest="34" HeightRequest="34" />
                                <Label Text="Pantalla" TextColor="White" FontSize="12" />
                                <Button Text="Abrir" FontSize="10" Padding="12,5" BackgroundColor="#10263E" TextColor="#49A3FF" CornerRadius="9" Clicked="BtnPantalla_Clicked" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#0D1722" Stroke="#182838" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="ic_keyboard.svg" WidthRequest="34" HeightRequest="34" />
                                <Label Text="Teclado" TextColor="White" FontSize="12" />
                                <Button Text="Abrir" FontSize="10" Padding="12,5" BackgroundColor="#10263E" TextColor="#49A3FF" CornerRadius="9" Clicked="BtnTeclado_Clicked" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#0D1722" Stroke="#182838" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Image Source="ic_mouse.svg" WidthRequest="34" HeightRequest="34" />
                                <Label Text="Ratón" TextColor="White" FontSize="12" />
                                <Button Text="Abrir" FontSize="10" Padding="12,5" BackgroundColor="#10263E" TextColor="#49A3FF" CornerRadius="9" Clicked="BtnTouchpad_Clicked" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- MÁS -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Más funciones" TextColor="White" FontSize="19" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Text="📁  Archivos" BackgroundColor="#0D1722" BorderColor="#182838" BorderWidth="1" TextColor="White" HeightRequest="54" CornerRadius="14" Clicked="BtnArchivos_Clicked" />
                        <Button Grid.Column="1" Text="▦  Aplicaciones" BackgroundColor="#0D1722" BorderColor="#182838" BorderWidth="1" TextColor="White" HeightRequest="54" CornerRadius="14" Clicked="BtnAplicaciones_Clicked" />
                        <Button Grid.Row="1" Text="▣  Estado PC" BackgroundColor="#0D1722" BorderColor="#182838" BorderWidth="1" TextColor="White" HeightRequest="54" CornerRadius="14" Clicked="BtnEstadoPc_Clicked" />
                        <Button Grid.Row="1" Grid.Column="1" Text="⚙  Herramientas" BackgroundColor="#0D1722" BorderColor="#182838" BorderWidth="1" TextColor="White" HeightRequest="54" CornerRadius="14" Clicked="BtnHerramientas_Clicked" />
                    </Grid>
                </VerticalStackLayout>

                <Button Text="Configurar conexión" BackgroundColor="#0B6EDB" TextColor="White" HeightRequest="50" CornerRadius="14" FontAttributes="Bold" Clicked="BtnConfigurarConexion_Clicked" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
