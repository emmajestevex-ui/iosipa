<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">

  <dict>

    <!-- ====================================================== -->
    <!-- CONFIGURACIÓN GENERAL -->
    <!-- ====================================================== -->

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UIDeviceFamily</key>
    <array>
      <integer>1</integer>
      <integer>2</integer>
    </array>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>


    <!-- ====================================================== -->
    <!-- ORIENTACIÓN IPHONE -->
    <!-- ====================================================== -->

    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>


    <!-- ====================================================== -->
    <!-- ORIENTACIÓN IPAD -->
    <!-- ====================================================== -->

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>


    <!-- ====================================================== -->
    <!-- PERMISO DE RED LOCAL -->
    <!-- Necesario para comunicarse con RemoControl Server -->
    <!-- ====================================================== -->

    <key>NSLocalNetworkUsageDescription</key>
    <string>RemoControl necesita acceder a tu red local para encontrar y controlar tu computadora.</string>


    <!-- ====================================================== -->
    <!-- CONEXIONES HTTP -->
    <!-- El servidor RemoControl actualmente usa HTTP :5050 -->
    <!-- ====================================================== -->

    <key>NSAppTransportSecurity</key>

    <dict>

      <key>NSAllowsArbitraryLoads</key>
      <true/>

      <key>NSAllowsLocalNetworking</key>
      <true/>

    </dict>


    <!-- ====================================================== -->
    <!-- ICONO -->
    <!-- ====================================================== -->

    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>

  </dict>

</plist>