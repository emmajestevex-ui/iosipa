<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>

    <RootNamespace>RemoControlMobile</RootNamespace>

    <UseMaui>true</UseMaui>

    <SingleProject>true</SingleProject>

    <ImplicitUsings>enable</ImplicitUsings>

    <Nullable>enable</Nullable>

    <ApplicationTitle>RemoControl</ApplicationTitle>

    <ApplicationId>com.remocontrol.mobile</ApplicationId>

    <ApplicationDisplayVersion>1.5.0</ApplicationDisplayVersion>

    <ApplicationVersion>6</ApplicationVersion>
   
    <!-- Android mínimo -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <!-- Windows mínimo -->


    <!-- Generar solamente APK -->
    <AndroidPackageFormats Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">apk</AndroidPackageFormats>

  </PropertyGroup>


  <ItemGroup>

    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#087BDB" />

    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101720" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />

    <MauiFont Include="Resources\Fonts\*" />

    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

  </ItemGroup>


  <ItemGroup>

    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.100" />

  </ItemGroup>


  <ItemGroup>
    <Compile Update="EstadoPcPage.xaml.cs">
      <DependentUpon>EstadoPcPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>


  <ItemGroup>
    <MauiXaml Update="AccesoRemotoPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="ActividadPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="ActualizacionesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="AplicacionesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="DiagnosticoPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="EquiposPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="EstadoPcPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="FavoritosPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="MultimediaPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="PortapapelesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="PrimeraConfiguracionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="RendimientoPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="SeguridadPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="SeleccionarAplicacionesPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="TecladoPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="TouchpadPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="UbicacionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
